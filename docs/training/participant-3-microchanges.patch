+using System.Globalization;
+using Microclimate.Client.Core.ViewModels;
+using Microclimate.Contracts.Common;
+using Microsoft.AspNetCore.WebUtilities;
+
+namespace Microclimate.Client.Tests;
+
+// Лише тренувальна копія: перевіряє дві мікрозміни для захисту.
+public sealed class DefensePracticeTests
+{
+    [Fact]
+    public async Task FourteenDaysSelectionAutomaticallyRequestsExactUtcRange()
+    {
+        using var f = new ClientFixture();
+        await f.SignInAsync();
+        var vm = new RoomDetailsViewModel(f.Api, f.Navigation, f.Clock, f.Session);
+        vm.SelectRoom(ClientFixture.RoomId, "101");
+        await vm.InitializeAsync();
+        f.Requests.Clear();
+        vm.SelectedPeriod = vm.Periods.Single(option => option.Days == 14);
+        await vm.SelectionRefresh;
+        var request = Assert.Single(f.Requests, item =>
+            item.Uri.AbsolutePath.EndsWith("/series", StringComparison.Ordinal)
+        );
+        var query = QueryHelpers.ParseQuery(request.Uri.Query);
+        var from = DateTimeOffset.Parse(query["from"].ToString(), CultureInfo.InvariantCulture);
+        var to = DateTimeOffset.Parse(query["to"].ToString(), CultureInfo.InvariantCulture);
+        Assert.Equal(f.Clock.Now, to);
+        Assert.Equal(TimeSpan.FromDays(14), to - from);
+        Assert.Equal("day", query["interval"].ToString());
+        Assert.Equal("temperature", query["metric"].ToString());
+    }
+
+    [Fact]
+    public async Task AlertsDefaultToOpenAndAllStatesRemovesQueryFilter()
+    {
+        using var f = new ClientFixture();
+        await f.SignInAsync();
+        var vm = new AlertsViewModel(f.Api, f.Session, f.Navigation);
+        Assert.Equal(AlertStatus.Open, vm.SelectedStatus.Value);
+        await vm.InitializeAsync();
+        var query = QueryHelpers.ParseQuery(Assert.Single(f.Requests).Uri.Query);
+        Assert.Equal("open", query["status"].ToString());
+        f.Requests.Clear();
+        vm.SelectedStatus = vm.Statuses.Single(option => option.Value == null);
+        await vm.RefreshCommand.ExecuteAsync(null);
+        query = QueryHelpers.ParseQuery(Assert.Single(f.Requests).Uri.Query);
+        Assert.False(query.ContainsKey("status"));
+        Assert.Equal("1", query["page"].ToString());
+    }
+}
