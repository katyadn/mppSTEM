# Локальна конфігурація; скопіюйте в .env і задайте власний пароль.
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
API_PORT=5195
# Датчик для симулятора: id з GET /api/v1/rooms/{roomId}/sensors і його X-Device-Key.
SIMULATOR_SENSOR_ID=
SIMULATOR_DEVICE_KEY=
SIMULATOR_SCENARIO=Normal
