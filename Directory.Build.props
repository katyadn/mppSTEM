<Project>
  <!-- Спільні правила C#, nullable та аналізаторів для solution; MAUI задає власні target frameworks. -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFrameworks)' == '' and '$(MSBuildProjectName)' != 'Microclimate.Client.Maui'">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- XML-коментарі доступні в IDE; окремий XML-файл за замовчуванням не генерується. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
