<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Microclimate.Client.Core.ViewModels;assembly=Microclimate.Client.Core"
             xmlns:views="clr-namespace:Microclimate.Client.Maui.Views"
             xmlns:controls="clr-namespace:Microclimate.Client.Maui.Controls"
             x:Name="PageRoot" x:Class="Microclimate.Client.Maui.Views.RoomDetailsPage"
             x:DataType="vm:RoomDetailsViewModel" Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Оновити" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsThresholdEditorClosed}" />
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView x:Name="RoomScroll" IsEnabled="{Binding IsThresholdEditorClosed}" SizeChanged="OnChartsSizeChanged">
            <VerticalStackLayout x:Name="RoomContent" Padding="24" Spacing="16" HorizontalOptions="Fill" SizeChanged="OnChartsSizeChanged">
                <Grid ColumnDefinitions="*,180" ColumnSpacing="20">
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{Binding ComfortText}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding RangeText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Picker Grid.Column="1" Title="Період" ItemsSource="{Binding Periods}"
                            ItemDisplayBinding="{Binding Name, x:DataType=vm:PeriodOption}"
                            SelectedItem="{Binding SelectedPeriod}" IsEnabled="{Binding IsNotBusy}" />
                </Grid>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                <Label Text="Жовті ділянки — некомфортно, червоні — критично. Пороги застосовуються до всієї історії."
                       Style="{StaticResource Caption}" />
                <Grid x:Name="ChartsGrid" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnChartsSizeChanged"
                      BindableLayout.ItemsSource="{Binding Charts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MetricChartViewModel">
                            <Border Padding="16">
                                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                                    <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                            <Label Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <ImageButton Grid.Column="1" Source="{AppThemeBinding Light=edit_thresholds.png, Dark=edit_thresholds_dark.png}"
                                                     WidthRequest="44" HeightRequest="44" Padding="11" CornerRadius="10"
                                                     BackgroundColor="Transparent" ToolTipProperties.Text="Налаштувати пороги"
                                                     SemanticProperties.Description="{Binding Name, StringFormat='Налаштувати пороги: {0}'}"
                                                     Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.OpenThresholdsCommand, x:DataType=views:RoomDetailsPage}"
                                                     CommandParameter="{Binding .}" />
                                    </Grid>
                                    <Grid Grid.Row="1" MinimumHeightRequest="180">
                                        <controls:TimeSeriesChart x:Name="MetricHistory" Segments="{Binding Series}" Unit="{Binding Unit}"
                                                                  Thresholds="{Binding Thresholds}" IsVisible="{Binding HasSeries}"
                                                                  LineColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Label Text="Немає вимірювань за цей період" IsVisible="{Binding HasNoSeries}"
                                               Style="{StaticResource Caption}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Grid.Row="2" Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="3" Text="{Binding Source={x:Reference MetricHistory}, Path=SelectedPointText, x:DataType=controls:TimeSeriesChart}"
                                           Style="{StaticResource Caption}" MinimumHeightRequest="18" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
                <Label Text="Натисніть на графік для значення й часу. Олівець відкриває пороги показника." Style="{StaticResource Caption}" />
                <Label Text="{Binding LiveStatus}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid IsVisible="{Binding IsThresholdEditorOpen}" BackgroundColor="#99000000" Padding="24">
            <Border MaximumWidthRequest="520" HorizontalOptions="Fill" VerticalOptions="Center" Padding="24">
                <ScrollView MaximumHeightRequest="650">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="{Binding ThresholdEditorTitle}" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindingContext="{Binding Thresholds}" x:DataType="vm:ThresholdsViewModel" Spacing="16">
                            <Label Text="{Binding Unit, StringFormat='Одиниці: {0}. Порожнє поле — без обмеження.'}" Style="{StaticResource Caption}" />
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                            <VerticalStackLayout Spacing="16" IsEnabled="{Binding CanSave}">
                                <Label Text="Некомфортно · жовтий" Style="{StaticResource FieldLabel}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Нижче" Style="{StaticResource FieldLabel}" />
                                        <Entry Text="{Binding WarningMin}" Placeholder="Не задано" Keyboard="Numeric" SemanticProperties.Description="Нижня межа попередження" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="Вище" Style="{StaticResource FieldLabel}" />
                                        <Entry Text="{Binding WarningMax}" Placeholder="Не задано" Keyboard="Numeric" SemanticProperties.Description="Верхня межа попередження" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="Критично · червоний" Style="{StaticResource FieldLabel}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Нижче" Style="{StaticResource FieldLabel}" />
                                        <Entry Text="{Binding CriticalMin}" Placeholder="Не задано" Keyboard="Numeric" SemanticProperties.Description="Критична нижня межа" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="Вище" Style="{StaticResource FieldLabel}" />
                                        <Entry Text="{Binding CriticalMax}" Placeholder="Не задано" Keyboard="Numeric" SemanticProperties.Description="Критична верхня межа" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Скасувати" Command="{Binding CloseThresholdsCommand}" IsEnabled="{Binding Thresholds.IsNotBusy}" Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="1" Text="Зберегти" Command="{Binding SaveThresholdsCommand}" IsEnabled="{Binding Thresholds.CanSave}" IsVisible="{Binding Thresholds.CanEdit}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
