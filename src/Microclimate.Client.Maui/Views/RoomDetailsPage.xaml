<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Microclimate.Client.Core.ViewModels;assembly=Microclimate.Client.Core" xmlns:controls="clr-namespace:Microclimate.Client.Maui.Controls" x:Name="PageRoot" x:Class="Microclimate.Client.Maui.Views.RoomDetailsPage"
 x:DataType="vm:RoomDetailsViewModel" Title="{Binding Title}">

<ScrollView><VerticalStackLayout Padding="24" Spacing="14">
<Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" />
<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
<Picker Title="Метрика" ItemsSource="{Binding Metrics}" ItemDisplayBinding="{Binding Name, x:DataType=vm:MetricOption}" SelectedItem="{Binding SelectedMetric}" IsEnabled="{Binding IsNotBusy}" />
<Picker Grid.Column="1" Title="Період" ItemsSource="{Binding Periods}" ItemDisplayBinding="{Binding Name, x:DataType=vm:PeriodOption}" SelectedItem="{Binding SelectedPeriod}" IsEnabled="{Binding IsNotBusy}" />
</Grid>
<Button Text="Застосувати / оновити" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" />
<Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#B00020" />
<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
<Label Text="{Binding RangeText}" />
<Label Text="Індекс комфорту" FontAttributes="Bold" /><Label Text="{Binding ComfortText}" FontSize="22" />
<Label Text="Історія вимірювань" FontAttributes="Bold" />
<Label Text="Немає вимірювань за обраний період" IsVisible="{Binding HasNoSeries}" />
<controls:TimeSeriesChart Segments="{Binding Series}" Unit="{Binding ChartUnit}" HeightRequest="240" IsVisible="{Binding HasSeries}" />
<Label Text="{Binding SummaryText}" />
<Button Text="Назад" Command="{Binding GoBackCommand}" />
</VerticalStackLayout></ScrollView></ContentPage>
