<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Microclimate.Client.Core.ViewModels;assembly=Microclimate.Client.Core"  x:Name="PageRoot" x:Class="Microclimate.Client.Maui.Views.LoginPage"
 x:DataType="vm:LoginViewModel" Title="{Binding Title}">
<ScrollView><VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="520" HorizontalOptions="Fill">
<Label Text="Мікроклімат" FontSize="30" FontAttributes="Bold" />
<Label Text="Увійдіть до свого облікового запису" />
<Label Text="Електронна пошта" />
<Entry Text="{Binding Email}" Keyboard="Email" Placeholder="name@example.com" IsEnabled="{Binding IsNotBusy}" />
<Label Text="Пароль" />
<Entry Text="{Binding Password}" IsPassword="True" Placeholder="Пароль" IsEnabled="{Binding IsNotBusy}" ReturnType="Go" ReturnCommand="{Binding LoginCommand}" />
<Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#B00020" />
<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
<Button Text="Увійти" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" />
<Button Text="Адреса API та налаштування" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding IsNotBusy}" />
</VerticalStackLayout></ScrollView></ContentPage>
