<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Microclimate.Client.Core.ViewModels;assembly=Microclimate.Client.Core"
             x:Class="Microclimate.Client.Maui.Views.LoginPage" x:DataType="vm:LoginViewModel"
             Title="{Binding Title}" Shell.NavBarIsVisible="False">
    <Grid SafeAreaEdges="SoftInput">
        <ScrollView>
            <VerticalStackLayout Padding="28,48" Spacing="24" MaximumWidthRequest="480" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Мікроклімат" Style="{StaticResource PageTitle}" />
                    <Label Text="Увійдіть до свого облікового запису" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Електронна пошта" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="name@example.com" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Description="Електронна пошта" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Пароль" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Введіть пароль" IsEnabled="{Binding IsNotBusy}" ReturnType="Go" ReturnCommand="{Binding LoginCommand}" SemanticProperties.Description="Пароль" />
                </VerticalStackLayout>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Text="Увійти" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Button Text="Налаштувати підключення" Style="{StaticResource TextButton}" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding IsNotBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
