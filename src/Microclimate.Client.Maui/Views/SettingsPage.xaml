<?xml version="1.0" encoding="utf-8" ?>
<!-- Редагування адреси API, відомості про профіль і спосіб збереження сесії, вихід. -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Microclimate.Client.Core.ViewModels;assembly=Microclimate.Client.Core"  x:Name="PageRoot" x:Class="Microclimate.Client.Maui.Views.SettingsPage"
 x:DataType="vm:SettingsViewModel" Title="{Binding Title}">

<ScrollView><VerticalStackLayout Padding="24" Spacing="14">
<Label Text="Налаштування" FontSize="28" FontAttributes="Bold" />
<Label Text="{Binding ProfileText}" /><Label Text="{Binding SessionText}" />
<Label Text="Адреса API" FontAttributes="Bold" />
<Entry Text="{Binding ServerAddress}" Keyboard="Url" Placeholder="https://api.example.com/" IsEnabled="{Binding IsNotBusy}" />
<Label Text="Після зміни сервера потрібно увійти знову." />
<Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#B00020" />
<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
<Label Text="{Binding Message}" />
<Button Text="Зберегти адресу" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
<Button Text="Вийти з облікового запису" Command="{Binding LogoutCommand}" IsEnabled="{Binding IsNotBusy}" />
<Button Text="До входу" Command="{Binding GoToLoginCommand}" />
</VerticalStackLayout></ScrollView></ContentPage>
