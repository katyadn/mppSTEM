<?xml version="1.0" encoding="utf-8" ?>
<!-- Фільтри й список сповіщень; доступність підтвердження враховує роль та стан сповіщення. -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Microclimate.Client.Core.ViewModels;assembly=Microclimate.Client.Core" xmlns:items="clr-namespace:Microclimate.Client.Core.Presentation;assembly=Microclimate.Client.Core" xmlns:views="clr-namespace:Microclimate.Client.Maui.Views" x:Name="PageRoot" x:Class="Microclimate.Client.Maui.Views.AlertsPage"
 x:DataType="vm:AlertsViewModel" Title="{Binding Title}">

<Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
<Label Text="Сповіщення" FontSize="28" FontAttributes="Bold" />
<Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
<Picker Title="Рівень" ItemsSource="{Binding Levels}" ItemDisplayBinding="{Binding Name, x:DataType=vm:AlertLevelOption}" SelectedItem="{Binding SelectedLevel}" IsEnabled="{Binding IsNotBusy}" />
<Picker Grid.Column="1" Title="Стан" ItemsSource="{Binding Statuses}" ItemDisplayBinding="{Binding Name, x:DataType=vm:AlertStatusOption}" SelectedItem="{Binding SelectedStatus}" IsEnabled="{Binding IsNotBusy}" />
</Grid>
<Button Grid.Row="2" Text="Застосувати / оновити" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" />
<Label Grid.Row="3" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#B00020" />
<RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
<CollectionView ItemsSource="{Binding Alerts}" SelectionMode="None">
<CollectionView.EmptyView><Label Text="Список сповіщень порожній. Оновіть список або змініть фільтр." Margin="0,20" /></CollectionView.EmptyView>
<CollectionView.ItemTemplate><DataTemplate x:DataType="items:AlertItem"><Border Padding="16" Margin="0,0,0,12"><VerticalStackLayout Spacing="8">
<Label Text="{Binding Message}" FontAttributes="Bold" /><Label Text="{Binding Details}" /><Label Text="{Binding Status}" />
<Button Text="Кімната" Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.OpenRoomCommand, x:DataType=views:AlertsPage}" CommandParameter="{Binding .}" />
<Button Text="Підтвердити" IsVisible="{Binding CanAcknowledge}" Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.AcknowledgeCommand, x:DataType=views:AlertsPage}" CommandParameter="{Binding .}" />
</VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
<CollectionView.Footer><Button Text="Завантажити ще" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" IsEnabled="{Binding IsNotBusy}" /></CollectionView.Footer>
</CollectionView></RefreshView></Grid></ContentPage>
