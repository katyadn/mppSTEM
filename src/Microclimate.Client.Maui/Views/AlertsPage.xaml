<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Microclimate.Client.Core.ViewModels;assembly=Microclimate.Client.Core"
             xmlns:items="clr-namespace:Microclimate.Client.Core.Presentation;assembly=Microclimate.Client.Core"
             xmlns:views="clr-namespace:Microclimate.Client.Maui.Views"
             x:Name="PageRoot" x:Class="Microclimate.Client.Maui.Views.AlertsPage"
             x:DataType="vm:AlertsViewModel" Title="{Binding Title}">
    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20" MaximumWidthRequest="1000" HorizontalOptions="Fill">
        <Label Text="{Binding LiveStatus}" Style="{StaticResource Caption}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
            <VerticalStackLayout Spacing="6"><Label Text="Рівень" Style="{StaticResource FieldLabel}" /><Picker Title="Рівень" ItemsSource="{Binding Levels}" ItemDisplayBinding="{Binding Name, x:DataType=vm:AlertLevelOption}" SelectedItem="{Binding SelectedLevel}" IsEnabled="{Binding IsNotBusy}" /></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="Стан" Style="{StaticResource FieldLabel}" /><Picker Title="Стан" ItemsSource="{Binding Statuses}" ItemDisplayBinding="{Binding Name, x:DataType=vm:AlertStatusOption}" SelectedItem="{Binding SelectedStatus}" IsEnabled="{Binding IsNotBusy}" /></VerticalStackLayout>
            <Button Grid.Row="1" Grid.ColumnSpan="2" Text="Застосувати фільтри" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
        </Grid>
        <Label Grid.Row="2" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
        <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding Alerts}" SelectionMode="None">
                <CollectionView.EmptyView><Label Text="За цими фільтрами сповіщень немає." Style="{StaticResource Caption}" Margin="0,20" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:AlertItem">
                        <Border Margin="0,0,0,16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding Message}" FontAttributes="Bold" />
                                <Label Text="{Binding Details}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Status}" Style="{StaticResource FieldLabel}" />
                                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween">
                                    <Button Text="Відкрити кімнату" Style="{StaticResource TextButton}" Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.OpenRoomCommand, x:DataType=views:AlertsPage}" CommandParameter="{Binding .}" />
                                    <Button Text="Підтвердити" IsVisible="{Binding CanAcknowledge}" Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.AcknowledgeCommand, x:DataType=views:AlertsPage}" CommandParameter="{Binding .}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer><Button Text="Завантажити ще" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" Margin="0,4,0,20" /></CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
